---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    <nav aria-label="Caminho de navegação" class="breadcrumbs">
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="intro-description">{description}</p>
  </div>
  <span class="intro-art" aria-hidden="true">
    ↗
  </span>
</section>
