---
import Icon from './Icon.astro';
---

<section class="association-cta" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">O próximo passo é coletivo</p>
      <h2 id="cta-title">
        Sua participação
        <br />
        faz a diferença.
      </h2>
      <p>Conheça a área de associação e os próximos passos.</p>
    </div>
    <a class="button button-light" href="/associacao/">
      Quero fazer parte <Icon name="arrow" size={20} />
    </a>
    <span class="cta-art" aria-hidden="true">
      ↗
    </span>
  </div>
</section>
