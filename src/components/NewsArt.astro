---
interface Props {
  variant: 'collective' | 'dialogue' | 'document';
}
const { variant } = Astro.props;
---

<div class:list={['news-art', `news-art-${variant}`]} aria-hidden="true">
  {variant === 'collective' && (
    <svg viewBox="0 0 400 230" fill="none">
      <circle cx="200" cy="112" r="88" stroke="currentColor" stroke-width="1" />
      <circle cx="145" cy="92" r="23" fill="#F5E5CE" />
      <path d="M104 210v-56a41 41 0 0 1 82 0v56" fill="#F5E5CE" />
      <circle cx="237" cy="75" r="29" fill="#ED754E" />
      <path d="M185 210v-78a52 52 0 0 1 104 0v78" fill="#ED754E" />
      <path
        d="M47 48h24m-12-12v24m263 106h24m-12-12v24"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
  )}
  {variant === 'document' && (
    <svg viewBox="0 0 400 230" fill="none">
      <circle cx="290" cy="70" r="65" fill="#F5D6B9" />
      <g transform="rotate(-9 200 115)">
        <rect x="117" y="25" width="158" height="190" rx="5" fill="#FAF8F1" />
        <path
          d="M143 63h88M143 82h59M143 119h103m-103 18h103m-103 18h75"
          stroke="#24493F"
          stroke-width="5"
        />
        <circle cx="238" cy="183" r="22" fill="#E46A42" />
      </g>
      <path d="m59 162 25-25m-25 0h25v25" stroke="#24493F" stroke-width="2" />
    </svg>
  )}
  {variant === 'dialogue' && (
    <svg viewBox="0 0 400 230" fill="none">
      <rect x="60" y="35" width="180" height="112" rx="30" fill="#F4E4CA" />
      <path d="m185 140 34 27v-35" fill="#F4E4CA" />
      <rect x="184" y="101" width="153" height="97" rx="28" fill="#E87952" />
      <path d="m226 191-27 24v-39" fill="#E87952" />
      <path
        d="M91 76h116m-116 23h73m139 45h-85m85 22h-56"
        stroke="#24493F"
        stroke-width="5"
      />
    </svg>
  )}
</div>
