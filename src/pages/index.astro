---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ContentNotice from '@/components/ContentNotice.astro';
import { contentRepository } from '@/lib/content-repository';
const [services, news] = await Promise.all([
  contentRepository.getServices(),
  contentRepository.getNews(),
]);
---

<BaseLayout
  title="Juntos, nossa voz vai mais longe"
  description="Conheça a Attue, sindicato profissional. Explore as áreas institucionais, serviços, benefícios, notícias e associação."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Attue · Sindicato profissional</p>
        <h1>
          Juntos, nossa
          <br />
          voz vai{' '}
          <em>
            mais
            <br />
            longe.
          </em>
        </h1>
        <p class="hero-lead">
          Um ponto de encontro entre você e o coletivo. Conheça a Attue e
          descubra os caminhos para participar.
        </p>
        <div class="hero-actions">
          <a href="/associacao/" class="button">
            Quero fazer parte <Icon name="arrow" size={18} />
          </a>
          <a href="/sobre/" class="button button-outline">
            Conheça a Attue
          </a>
        </div>
        <p class="hero-caption">
          <Icon name="people" size={20} />
          <span>Uma nova forma de estar mais perto.</span>
        </p>
      </div>
      <figure class="hero-visual">
        <span class="visual-tag">Pessoas. Diálogo. Coletivo.</span>
        <img
          src="/images/collective.svg"
          width="620"
          height="640"
          alt="Ilustração conceitual de três pessoas lado a lado, representando a união profissional"
          fetchpriority="high"
        />
        <figcaption>
          Ilustração conceitual · identidade visual proposta
        </figcaption>
      </figure>
    </div>
  </section>
  <div class="container quick-links">
    <a class="quick-link" href="/servicos/">
      <Icon name="message" size={28} />
      <div>
        <strong>Como podemos ajudar?</strong>
        <span>Conheça a área de serviços</span>
      </div>
      <Icon name="arrow" size={20} />
    </a>
    <a class="quick-link" href="/beneficios/">
      <Icon name="heart" size={28} />
      <div>
        <strong>Conexões que somam</strong>
        <span>Explore a área de benefícios</span>
      </div>
      <Icon name="arrow" size={20} />
    </a>
    <a class="quick-link" href="/contato/">
      <Icon name="people" size={28} />
      <div>
        <strong>Vamos conversar</strong>
        <span>Acesse a área de contato</span>
      </div>
      <Icon name="arrow" size={20} />
    </a>
  </div>
  <section class="section">
    <div class="container about-home">
      <div>
        <p class="eyebrow">Conheça a Attue</p>
        <h2>
          O valor de cada voz.
          <br />A força de
          <br />
          um coletivo.
        </h2>
      </div>
      <div class="about-copy">
        <p>
          A Attue é um sindicato profissional. Este é o espaço para conhecer sua
          identidade, acompanhar informações institucionais e encontrar os
          caminhos de participação.
        </p>
        <p>
          A história, a categoria representada e as frentes de atuação serão
          apresentadas aqui após confirmação oficial.
        </p>
        <a class="text-link" href="/sobre/">
          Saiba mais sobre a Attue <Icon name="arrow" size={19} />
        </a>
        <div class="about-signature">
          <span>
            <Icon name="document" size={17} />
          </span>
          <span>Conteúdo institucional em preparação.</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section services-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Perto de você</p>
          <h2>
            Informação e apoio
            <br />
            para o seu caminho.
          </h2>
        </div>
        <a class="text-link" href="/servicos/">
          Explorar serviços <Icon name="arrow" size={19} />
        </a>
      </div>
      <div class="services-grid">
        {services.map((item, index) => (
          <ServiceCard item={item} index={index} />
        ))}
      </div>
      <p class="section-footnote">
        <Icon name="document" size={16} />
        Os itens acima são espaços de conteúdo. Serviços e condições aguardam
        confirmação oficial.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container benefits-home">
      <div class="benefit-visual" aria-hidden="true">
        <div class="benefit-circle"></div>
        <div class="benefit-circle"></div>
        <span class="benefit-symbol">&</span>
        <small>Você & o coletivo. Uma conexão que soma.</small>
      </div>
      <div class="benefit-copy">
        <p class="eyebrow">Fazer parte é somar</p>
        <h2>
          Mais possibilidades.
          <br />
          Novas conexões.
        </h2>
        <p>
          Uma área dedicada aos benefícios da associação, com informações claras
          sobre acesso, condições e eventuais parcerias.
        </p>
        <ContentNotice text="Benefícios e convênios ainda não foram confirmados. Os detalhes serão publicados após aprovação da Attue." />
        <a href="/beneficios/" class="text-link">
          Conhecer a área de benefícios <Icon name="arrow" size={19} />
        </a>
      </div>
    </div>
  </section>
  <section class="section news-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Acompanhe de perto</p>
          <h2>O que nos conecta.</h2>
        </div>
        <a class="text-link" href="/noticias/">
          Todas as publicações <Icon name="arrow" size={19} />
        </a>
      </div>
      <div class="news-grid">
        {news.slice(0, 3).map((article) => (
          <NewsCard article={article} />
        ))}
      </div>
      <p class="section-footnote">
        <Icon name="document" size={16} />
        Publicações demonstrativas, reservadas para conteúdo oficial. Nenhuma
        notícia está sendo anunciada.
      </p>
    </div>
  </section>
</BaseLayout>
